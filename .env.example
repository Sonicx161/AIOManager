# ==============================================================================
#  One manager to rule them all. Local-first, Encrypted, Powerful.
# ==============================================================================
#
# This file is GENERATED from the validated schema in server/lib/env.js.
# Every variable below is checked at server boot: wrong types or out-of-range
# values stop the process with a message naming the variable. Defaults shown
# here are the exact code defaults.
#
# Regenerate after changing the schema:  npm --prefix server run gen:env
#

# ==============================================================================
#  ESSENTIAL SETUP
# ==============================================================================

# --- PORT ---
# Port the server listens on (bound to 0.0.0.0). Local development tip: use
# 16100 to avoid clashing with a Docker container mapped to host port 1610.
# integer | default: 1610 | 1..65535
PORT=1610

# --- NODE_ENV ---
# Runtime mode. Only "development" changes behavior (verbose/dev helpers in a
# few modules); all other values including "production", "staging", "prod", etc.
# are treated identically.
# string | default: production
NODE_ENV=production

# --- DATA_DIR ---
# Directory for the SQLite database, the generated server_secret.key and traces.
# In Docker this must match the volume mount path (e.g. /app/data). Default:
# <server>/data
# string | default: <server>/data (Docker: /app/data)
#DATA_DIR=/app/data

# --- MAX_SYNC_PAYLOAD_SIZE ---
# Maximum size in bytes of the encrypted sync-state blob accepted by the sync
# API. Default: 100 MB (104857600).
# integer | default: 104857600 | >= 1
#MAX_SYNC_PAYLOAD_SIZE=104857600

# ==============================================================================
#  DATABASE
# ==============================================================================
# Pool settings are ignored when DB_TYPE=sqlite.

# --- DB_TYPE ---
# Database engine: sqlite (zero-config, file-based) or postgres (recommended for
# scale / multi-tenant).
# string | one of: sqlite, postgres
DB_TYPE=sqlite

# --- DATABASE_URL ---
# PostgreSQL connection string, e.g. postgres://user:password@host:5432/dbname.
# REQUIRED when DB_TYPE=postgres, ignored for sqlite. Leave unset for SQLite.
# string | optional
#DATABASE_URL=

# --- DB_SSL_REJECT_UNAUTHORIZED ---
# Verify the PostgreSQL server TLS certificate. Disabled by default because many
# providers use self-signed certificates; enable only with a trusted, pinned
# certificate path.
# boolean | default: false
#DB_SSL_REJECT_UNAUTHORIZED=false

# --- DB_POOL_SIZE ---
# Maximum number of PostgreSQL pool connections (ignored when DB_TYPE=sqlite).
# integer | default: 20 | >= 1
#DB_POOL_SIZE=20

# --- DB_CONNECTION_TIMEOUT ---
# Milliseconds to wait for a pool connection before timing out (PostgreSQL
# only).
# integer | default: 10000 | >= 1
#DB_CONNECTION_TIMEOUT=10000

# --- DB_MAX_RETRIES ---
# Number of PostgreSQL connection attempts on startup with exponential backoff.
# The stored-settings read and the database connection each retry this many
# times, so a database that never comes up delays boot through two retry rounds.
# integer | default: 5 | >= 1
#DB_MAX_RETRIES=5

# --- READ_ONLY_REPLICA ---
# Run as a read-only standby against a replicated PostgreSQL database: skips
# schema/migrations and never starts the autopilot or activity workers, so the
# standby makes no background writes against your accounts. GET /api/health
# stays 200 while GET /api/ready returns 503, so point write-routing probes at
# /api/ready. Replicated rows are encrypted with the primary key: set
# ENCRYPTION_KEY (or copy server_secret.key) to the SAME value as the primary,
# otherwise the standby serves empty configs/addons. To take over: promote the
# replica (pg_promote) and restart with this unset.
# boolean | default: false
#READ_ONLY_REPLICA=false

# ==============================================================================
#  SECURITY
# ==============================================================================

# --- ENCRYPTION_KEY ---
# Encrypts sensitive data at rest (autopilot rules, Stremio auth keys,
# connection credentials). Zero-config: when empty, a secure random key is
# generated on first boot and saved to DATA_DIR/server_secret.key. Setting a
# value later keeps the old file key as a decrypt fallback so existing data
# stays readable.
# string | optional
#ENCRYPTION_KEY=

# --- CORS_ORIGINS ---
# Comma-separated allow-list of browser origins for the API, e.g.
# https://app.example.com,https://stremio.example.com. Empty = localhost-only
# development defaults.
# comma-separated list | default: localhost development origins (3000/5173/4173)
#CORS_ORIGINS=

# --- SSRF_ALLOW_PRIVATE ---
# Allow the metadata proxy to fetch addon manifests from private/internal IP
# ranges (Docker networks, DNS rewrites, reverse proxies). Only enable on
# trusted self-hosted instances behind a firewall.
# boolean | default: false
#SSRF_ALLOW_PRIVATE=false

# --- TRUST_PROXY ---
# Trust X-Forwarded-For headers from the reverse proxy (Traefik/nginx/NPM).
# Required behind a proxy for per-client rate limiting to see real client IPs;
# without it all proxied clients share one rate-limit bucket. WARNING: your
# proxy must OVERWRITE X-Forwarded-For with the real client IP ($remote_addr),
# not append to it. With append-style proxies this setting lets clients pick
# their own IP by sending a forged X-Forwarded-For header, which defeats rate
# limiting and forges logs.
# boolean | default: false
#TRUST_PROXY=false

# --- CUSTOM_HTML ---
# Raw HTML injected at the top of the login/configuration page (hosted-instance
# banners, announcements).
# string | optional
#CUSTOM_HTML=

# --- REGISTRATIONS_CLOSED ---
# Block new account creation while existing users can still sign in.
# boolean | default: false
#REGISTRATIONS_CLOSED=false

# --- UNIFIED_ENFORCEMENT ---
# Unify certain server-side enforcement checks across modules. Leave disabled
# for the default per-module behavior.
# boolean | default: false
#UNIFIED_ENFORCEMENT=false

# ==============================================================================
#  DASHBOARD (OPT-IN)
# ==============================================================================
# Instance Dashboard for self-hosters at /dashboard. To turn it on, set
# ADMIN_ENABLED=true and ADMIN_CREDENTIALS. Proxies and home networks work
# without any other setting.

# --- ADMIN_ENABLED ---
# Turn on the Dashboard at /dashboard. It manages the instance only; it can
# never read user addons, credentials or watch history. When off, the Dashboard
# does not exist (404).
# boolean | default: false
#ADMIN_ENABLED=false

# --- ADMIN_CREDENTIALS ---
# Dashboard sign-in as username:password, in quotes. Everything before the first
# colon is the username and everything after it is the password, so the password
# may contain colons. Change it and restart to change the sign-in.
# string | optional
# Example: ADMIN_CREDENTIALS="Sonic:SonicsPassword"
#ADMIN_CREDENTIALS=

# ==============================================================================
#  DASHBOARD ADVANCED (OPTIONAL)
# ==============================================================================
# Leave these empty unless you need them. The defaults work behind Traefik,
# nginx or Caddy and on your home network.

# --- ADMIN_ALLOW_IPS ---
# Optional comma-separated IPs or CIDR ranges allowed to reach the Dashboard,
# e.g. 192.168.1.0/24,10.0.0.5. Others get a plain 404 before any password
# check. Empty allows every address.
# string | optional
#ADMIN_ALLOW_IPS=

# --- ADMIN_ALLOW_HTTP_LAN ---
# Allow Dashboard sign-in over plain HTTP from your own network (loopback and
# private addresses such as 192.168.x.x). Sign-in from a public address always
# needs HTTPS. Set to false to require HTTPS on your network too; without HTTPS
# the password and session cookie cross your network unencrypted.
# boolean | default: true
#ADMIN_ALLOW_HTTP_LAN=true

# --- TRUST_PROXY_HOPS ---
# How the Dashboard finds the real client address behind a reverse proxy
# (Traefik, nginx, Caddy). auto (default): a proxy on the same machine, a Docker
# network or your LAN is detected from the X-Forwarded-* headers it sends, so
# nothing needs setting. A number from 1 to 10 sets the exact count of proxies
# in a chain. 0 turns proxy support off. Publish the proxy, not the server port:
# if the server port is also reachable on your network, another device could
# claim any address to slip past the sign-in lockout. A proxy that sends no
# X-Forwarded-For makes every visitor share one sign-in lockout; Traefik, Caddy
# and most nginx setups send it.
# string | default: auto
#TRUST_PROXY_HOPS=auto

# --- TRUSTED_PROXY_CIDRS ---
# Optional comma-separated IPs or CIDR ranges of your reverse proxies, e.g.
# 172.18.0.0/16. Leave empty to trust any proxy on the same machine, a Docker
# network or your LAN. Set it to pin trust to your exact proxy, or to allow a
# proxy on a public address.
# string | optional
#TRUSTED_PROXY_CIDRS=

# --- ADMIN_SECRET_HASH ---
# Alternative Dashboard password as a scrypt hash (never the plaintext).
# Generate it with: npm --prefix server run admin:hash. Used when
# ADMIN_CREDENTIALS is empty; takes precedence over a username and password
# chosen through ADMIN_SETUP. An invalid value keeps the Dashboard off with a
# log line.
# string | optional
#ADMIN_SECRET_HASH=

# --- ADMIN_USERNAME ---
# Dashboard sign-in username that goes with ADMIN_SECRET_HASH. Compared trimmed
# and case-insensitively. Defaults to admin when ADMIN_SECRET_HASH is set
# without it.
# string | optional
#ADMIN_USERNAME=

# --- ADMIN_SETUP ---
# Set to token to choose the Dashboard username and password in the browser
# instead of ADMIN_SECRET_HASH: while none exists, boot prints a single-use
# Dashboard setup token to stdout (valid 15 minutes). Restart with token again
# to issue a new one.
# string | one of: off, token
#ADMIN_SETUP=off

# ==============================================================================
#  LOGGING
# ==============================================================================

# --- LOG_LEVEL ---
# Server log verbosity: fatal, error, warn, info, debug or trace.
# string | one of: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# --- LOG_PRETTY_PRINT ---
# Pretty-print logs for humans (true) or emit JSON lines for log shippers
# (false). Recommended: false in production.
# boolean | default: true
LOG_PRETTY_PRINT=true

# ==============================================================================
#  PROXY & IMAGE CACHING
# ==============================================================================

# --- PROXY_CONCURRENCY_LIMIT ---
# Maximum concurrent outbound proxy/metadata requests the server fans out.
# integer | default: 50 | >= 1
#PROXY_CONCURRENCY_LIMIT=50

# --- AIOSTREAMS_USER_API_THROTTLE_MS ---
# Minimum interval in ms between calls to a single AIOStreams user API endpoint.
# integer | default: 1000 | >= 200
#AIOSTREAMS_USER_API_THROTTLE_MS=1000

# --- IMAGE_PROXY_TIMEOUT_MS ---
# Per-request timeout in ms for the poster/image proxy. Lower fails fast so the
# shared queue drains instead of clogging on a slow image source.
# integer | default: 4000 | >= 1000
#IMAGE_PROXY_TIMEOUT_MS=4000

# --- IMAGE_PROXY_QUEUE_LIMIT ---
# Max queued plus in-flight image-proxy requests; isolates poster storms from
# the stream/manifest proxies sharing the global queue. Requests past it fail at
# once, so it must cover several users opening poster pages together. Capped at
# 60% of the shared queue (300) so posters always leave room for other proxy
# traffic.
# integer | default: 300 | >= 30
#IMAGE_PROXY_QUEUE_LIMIT=300

# --- IMAGE_PROXY_THROTTLE_MS ---
# Minimum interval in ms between image-proxy calls to a single host. MetaHub is
# a CDN, so this stays far below the global throttle. 0 disables.
# integer | default: 5 | >= 0
#IMAGE_PROXY_THROTTLE_MS=5

# --- IMAGE_CACHE_TTL_MS ---
# TTL in ms for the shared in-memory poster cache: hot posters serve from memory
# and identical cold requests collapse into one upstream fetch. 0 disables.
# integer | default: 86400000 | >= 0
#IMAGE_CACHE_TTL_MS=86400000

# --- IMAGE_CACHE_MAX_BYTES ---
# Total byte budget for the in-memory poster cache (bounded by bytes, not entry
# count). Default: 128 MB. 0 disables the cache.
# integer | default: 134217728 | >= 0
#IMAGE_CACHE_MAX_BYTES=134217728

# --- IMAGE_CACHE_MAX_ITEM_BYTES ---
# Reject single cache entries larger than this many bytes. Default: 512 KB. 0
# disables the limit.
# integer | default: 524288 | >= 0
#IMAGE_CACHE_MAX_ITEM_BYTES=524288

# --- DATASTORE_META_BATCH_MAX ---
# Maximum accounts per DatastoreMetaBatch request (the batched library mtime
# pre-check). Bounded so one request cannot fan out unbounded upstream fetches.
# integer | default: 50 | >= 1
#DATASTORE_META_BATCH_MAX=50

# --- DATASTORE_META_BATCH_CONCURRENCY ---
# Upstream fan-out concurrency inside one DatastoreMetaBatch request.
# integer | default: 8 | >= 1
#DATASTORE_META_BATCH_CONCURRENCY=8

# --- DATASTORE_META_BATCH_ENTRY_TIMEOUT_MS ---
# Per-entry upstream timeout for DatastoreMetaBatch; a dead platform fails its
# slot fast instead of stalling the batch. Failed entries return null and the
# client falls back to that account's full path.
# integer | default: 8000 | >= 1000
#DATASTORE_META_BATCH_ENTRY_TIMEOUT_MS=8000

# ==============================================================================
#  ACTIVITY ENGINE (OPT-IN)
# ==============================================================================
# Safe defaults shown. Only relevant when you explicitly opt into server-side
# activity capture via ACTIVITY_ENGINE_ENABLED. Events are kept permanently so
# Activity can behave like Replay.

# --- ACTIVITY_ENGINE_ENABLED ---
# Opt in to server-side background polling that captures watch activity (events
# + snapshots) on a timer, so Activity/Replay history builds even with no client
# open. Multi-tenant warning: every account is polled each cycle (the
# write-amplification pattern behind the Midnight incident), so enable it only
# on single-user/trusted instances. Client-side Activity tracking works without
# this.
# boolean | default: false
ACTIVITY_ENGINE_ENABLED=false

# --- ACTIVITY_SCAN_INTERVAL_MS ---
# Base delay in ms between activity scans.
# integer | default: 300000 | >= 60000
ACTIVITY_SCAN_INTERVAL_MS=300000

# --- ACTIVITY_SCAN_JITTER_MS ---
# Random extra delay in ms (0..value) spread over accounts to avoid a thundering
# herd.
# integer | default: 120000 | >= 0
ACTIVITY_SCAN_JITTER_MS=120000

# --- ACTIVITY_INITIAL_DELAY_MS ---
# Delay in ms before the first scan after boot.
# integer | default: 30000 | >= 5000
ACTIVITY_INITIAL_DELAY_MS=30000

# --- ACTIVITY_CYCLE_BUDGET_MS ---
# Wall-clock budget in ms per scan cycle.
# integer | default: 120000 | >= 10000
ACTIVITY_CYCLE_BUDGET_MS=120000

# --- ACTIVITY_MAX_ACCOUNTS_PER_CYCLE ---
# Hard cap on accounts scanned per cycle.
# integer | default: 50 | >= 1
ACTIVITY_MAX_ACCOUNTS_PER_CYCLE=50

# --- ACTIVITY_MAX_EVENTS_PER_CYCLE ---
# Hard cap on activity events written per cycle.
# integer | default: 1000 | >= 1
ACTIVITY_MAX_EVENTS_PER_CYCLE=1000

# --- ACTIVITY_MAX_SNAPSHOT_WRITES_PER_CYCLE ---
# Hard cap on snapshot rows written per cycle.
# integer | default: 5000 | >= 1
ACTIVITY_MAX_SNAPSHOT_WRITES_PER_CYCLE=5000

# --- ACTIVITY_BATCH_SIZE ---
# Events accumulated before a batched database write.
# integer | default: 40 | >= 1
ACTIVITY_BATCH_SIZE=40

# --- ACTIVITY_FETCH_TIMEOUT_MS ---
# Per-account fetch timeout in ms.
# integer | default: 10000 | >= 1000
ACTIVITY_FETCH_TIMEOUT_MS=10000

# --- ACTIVITY_HASH_CACHE_TTL_MS ---
# TTL in ms for the per-account state-hash cache.
# integer | default: 86400000 | >= 60000
ACTIVITY_HASH_CACHE_TTL_MS=86400000

# --- ACTIVITY_HASH_CACHE_MAX ---
# Maximum number of accounts tracked in the state-hash cache.
# integer | default: 5000 | >= 100
ACTIVITY_HASH_CACHE_MAX=5000

# --- ACTIVITY_SCAN_CONCURRENCY ---
# Maximum accounts scanned in parallel per activity cycle. Write reservations
# preserve the cycle event and snapshot caps.
# integer | default: 4 | >= 1
ACTIVITY_SCAN_CONCURRENCY=4

# --- ACTIVITY_BREAKER_THRESHOLD ---
# Consecutive fetch failures before an account enters breaker backoff. 1 trips
# on the first failure.
# integer | default: 2 | >= 1
ACTIVITY_BREAKER_THRESHOLD=2

# --- ACTIVITY_BREAKER_BASE_MS ---
# First breaker backoff window in ms for an account whose library fetch keeps
# failing. 0 disables the breaker.
# integer | default: 300000 | >= 0
ACTIVITY_BREAKER_BASE_MS=300000

# --- ACTIVITY_BREAKER_MAX_MS ---
# Ceiling in ms for the exponential breaker backoff (doubles per additional
# consecutive failure).
# integer | default: 3600000 | >= 0
ACTIVITY_BREAKER_MAX_MS=3600000

# ==============================================================================
#  AUTOPILOT ENGINE
# ==============================================================================

# --- AUTOPILOT_SCAN_CHUNK_SIZE ---
# Maximum rules scanned per autopilot cycle.
# integer | default: 500 | >= 100
#AUTOPILOT_SCAN_CHUNK_SIZE=500

# --- AUTOPILOT_MAX_RULES_PER_CYCLE ---
# Hard cap on rules processed in a single cycle. Autopilot only writes tiny
# timestamp updates, so large values are safe. Effectively max(scan chunk size,
# this value).
# integer | default: 10000 | >= 100
#AUTOPILOT_MAX_RULES_PER_CYCLE=10000

# --- AUTOPILOT_CYCLE_BUDGET_MS ---
# Wall-clock budget in ms per autopilot cycle. With 1000+ rules, 120s gives
# ample time for health checks.
# integer | default: 120000 | >= 5000
#AUTOPILOT_CYCLE_BUDGET_MS=120000

# --- AUTOPILOT_HEALTH_CACHE_TTL_MS ---
# How long addon health-check results are cached, in ms.
# integer | default: 30000 | >= 10000
#AUTOPILOT_HEALTH_CACHE_TTL_MS=30000

# --- AUTOPILOT_MANIFEST_PROBES_PER_HOST ---
# Maximum manifest health checks in flight to one addon host. Public hosts serve
# a unique manifest per user, so this bounds the load one instance puts on them.
# integer | default: 6 | >= 1
#AUTOPILOT_MANIFEST_PROBES_PER_HOST=6

# --- AUTOPILOT_HEALTH_TARGETS_MAX ---
# Most health targets (app instances) Autopilot keeps state for in memory.
# Targets no rule referenced for 30 minutes go first, then the least recently
# referenced.
# integer | default: 20000 | >= 100
#AUTOPILOT_HEALTH_TARGETS_MAX=20000

# --- AUTOPILOT_RULE_CONCURRENCY ---
# Accounts the autopilot worker checks in parallel. Each finishes on its own, so
# one slow addon never holds up the rest.
# integer | default: 32 | >= 1
#AUTOPILOT_RULE_CONCURRENCY=32

# --- AUTOPILOT_RULE_RECHECK_MS ---
# Minimum interval in ms before a rule is re-evaluated.
# integer | default: 30000 | >= 10000
#AUTOPILOT_RULE_RECHECK_MS=30000

# --- AUTOPILOT_RULE_CACHE_MAX_BYTES ---
# Byte budget for caching rules stable columns (addon_list/priority_chain) in
# memory so the worker stops re-reading them every cycle, a big win on remote
# databases (e.g. Supabase). Default: 256 MB. 0 disables.
# integer | default: 268435456 | >= 0
#AUTOPILOT_RULE_CACHE_MAX_BYTES=268435456

# --- AUTOPILOT_RULE_CACHE_TTL_MS ---
# Safety-net TTL in ms for the rule cache. Invalidation is event-driven (writes
# bump updated_at); this only caps how long an idle entry stays in memory.
# Default: 24 hours.
# integer | default: 86400000 | >= 60000
#AUTOPILOT_RULE_CACHE_TTL_MS=86400000

# --- AUTOPILOT_WRITE_TRIPWIRE ---
# Last-resort Autopilot write tripwire. Counts every engine-driven write
# (cycles, failover commits, stats, history) to autopilot_rules,
# autopilot_rule_stats and failover_history over a rolling 60 minutes. User rule
# saves and the echo they trigger never count here; they use the per-owner
# budget below. Above the limits below Autopilot enters safe mode: no DB writes,
# Stremio/Nuvio/RealStream pushes, swaps or webhooks, so every user keeps their
# current addons. Safe mode is in memory only and lasts until the process
# restarts (fix the cause, then restart). /api/health shows autopilot.safeMode
# while it holds. false disables the tripwire and the per-owner budget.
# boolean | default: true
#AUTOPILOT_WRITE_TRIPWIRE=true

# --- AUTOPILOT_WRITE_TRIPWIRE_PER_HOUR ---
# Write statements per rolling hour that trip the tripwire. 0 derives max(600,
# active rules x 20), where active rules are those the engine checked in the
# last hour. Expected v1 load: 0 rule writes per steady cycle, heartbeat stats
# batched 100 rows per statement, and about 3 statements per failover or
# recovery (measured: 500 rules failing over in one cycle and recovering wrote
# 6.03 per rule). 20 per rule leaves room for every rule to fail over and
# recover three times in the same hour. The scheduler checks a rule at most once
# per 60s cycle, so a loop that rewrites a rule every cycle (60 per rule per
# hour) trips within about 20 minutes, and a tight loop within seconds.
# integer | default: 0 | >= 0
#AUTOPILOT_WRITE_TRIPWIRE_PER_HOUR=0

# --- AUTOPILOT_WRITE_TRIPWIRE_BYTES_PER_HOUR ---
# Parameter bytes written per rolling hour that trip the tripwire. 0 derives
# max(50 MB, active rules x 1 MB). A typical encrypted addon_list is about 66 KB
# (measured: the 500-rule outage and recovery wrote 66 MB, which a flat 50 MB
# cap would have tripped), so 1 MB per rule allows about 15 full rewrites per
# rule per hour. A loop rewriting addon_list on every rule each cycle trips in
# about 15 minutes even at a low statement count.
# integer | default: 0 | >= 0
#AUTOPILOT_WRITE_TRIPWIRE_BYTES_PER_HOUR=0

# --- AUTOPILOT_OWNER_WRITES_PER_HOUR ---
# Per-owner rolling-hour budget of Autopilot table writes from that owner's own
# rule saves and the immediate enforcement each save triggers. Above it only
# that owner gets HTTP 429 ("Too many Autopilot changes, try again in N
# minutes") until the window rolls; other users and the engine are unaffected. A
# save costs 1 to 2 statements, so 300 covers re-saving a 100-rule account plus
# its echoes with room to spare. In memory only, up to 10000 owners (least
# recently active dropped first, idle owners pruned after an hour).
# integer | default: 300 | >= 1
#AUTOPILOT_OWNER_WRITES_PER_HOUR=300

# --- AUTOPILOT_OWNER_ADDON_LIST_BYTES_PER_HOUR ---
# Per-owner rolling-hour cap on addon_list bytes written by that owner's rule
# saves and their echo. Default 32 MB, about 500 rewrites of a typical 66 KB
# encrypted collection. Exceeding it returns the same per-owner 429.
# integer | default: 33554432 | >= 1
#AUTOPILOT_OWNER_ADDON_LIST_BYTES_PER_HOUR=33554432

# --- AUTOPILOT_TRIPWIRE_WEBHOOK_URL ---
# Optional hoster alert: when the write tripwire trips, one short JSON message
# (Discord content / Slack text compatible, no user data) is POSTed here through
# the SSRF-guarded fetch. Sent once per process.
# string | optional
#AUTOPILOT_TRIPWIRE_WEBHOOK_URL=

# ==============================================================================
#  INTERNAL / DEBUG
# ==============================================================================
# Do not set these manually.

# --- SQLITE_DB_PATH ---
# INTERNAL: set programmatically by database/setup.js at boot (defaults to
# DATA_DIR/aio.db). Do not set manually.
# string | optional
#SQLITE_DB_PATH=

# --- AIOMAN_TRACE ---
# INTERNAL: request tracing to DATA_DIR/trace.log for debugging. Accepts
# 1/true/yes/on.
# boolean | default: false
#AIOMAN_TRACE=false

